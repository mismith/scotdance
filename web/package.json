{
  "name": "scotdance-web",
  "private": true,
  "version": "4.0.0-alpha.0",
  "type": "module",
  "description": "Highland dancing event tracker",
  "author": "Murray Rowan <murray@mismith.info>",
  "scripts": {
    "dev": "vite",
    "emulate": "cd .. && firebase emulators:start --import=.firebase/emulator-data --export-on-exit",
    "local": "concurrently -k -n emulate,vite -c blue,green \"npm:emulate\" \"vite --mode emulator\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "report": "vite-bundle-visualizer"
  },
  "dependencies": {
    "@vueuse/core": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.2.0",
    "fuse.js": "^7.3.0",
    "lucide-vue-next": "^0.474.0",
    "pinia": "^2.3.1",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuefire": "^3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vue-tsc": "^2.2.0"
  }
}
