{
  "hosting": {
    "public": "web/dist-connect",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
          }
        ]
      },
      {
        "source": "/dancer-editor.html",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors https://entries.scotdance.app https://dev.entries.scotdance.app https://binder.scotdance.app https://*.scotdance.site; object-src 'none'; base-uri 'self'"
          }
        ]
      },
      {
        "source": "/dancer-editor.js",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/verify-email",
        "destination": "/verify-email.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "site": "scotdance-connect"
  }
}
