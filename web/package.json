{
  "name": "scotdance-web",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "Highland dancing event tracker",
  "author": "Murray Rowan <murray@mismith.info>",
  "scripts": {
    "init": "cp -n .env.example .env.local",
    "dev:functions": "npm --prefix ../functions run dev",
    "dev:web": "vite",
    "dev": "concurrently -k -n fn,web -c magenta,green \"npm:dev:functions\" \"npm:dev:web\"",
    "emulate:firebase": "cd .. && firebase emulators:start --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data",
    "emulate:typesense": "cd .. && docker rm -f scotdance-typesense >/dev/null 2>&1; docker run --rm --name scotdance-typesense -p 8108:8108 -v \"$PWD/.typesense/emulator-data:/data\" typesense/typesense:0.23.1 --data-dir /data --api-key=xyz --enable-cors",
    "local": "cd .. && PATH=\"$(ls -d \"$HOME\"/.nvm/versions/node/v\"$(cat .nvmrc)\".* 2>/dev/null | sort -V | tail -1)/bin:$PATH\" firebase emulators:exec --inspect-functions --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data 'cd web && concurrently -k -n fn,ts,web -c magenta,yellow,green npm:dev:functions npm:emulate:typesense \"vite --mode emulator --port 5273\"'",
    "ios": "cd .. && npx cap run ios --live-reload --host $(ipconfig getifaddr en0) --port ${PORT:-5273}",
    "android": "cd .. && npx cap run android --live-reload --host $(ipconfig getifaddr en0) --port ${PORT:-5273}",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,json,css}\"",
    "report": "REPORT=true vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@lucide/vue": "^1.14.0",
    "@unhead/vue": "^3.4.2",
    "@vue-dnd-kit/core": "^2.4.7",
    "@vueuse/core": "^14.3.0",
    "@vueuse/router": "^14.3.0",
    "compare-versions": "^6.1.1",
    "crisp-sdk-web": "^1.1.2",
    "dompurify": "^3.4.16",
    "firebase": "^12.12.1",
    "fuse.js": "^7.3.0",
    "maplibre-gl": "^6.11.2",
    "pinia": "^3.0.4",
    "read-excel-file": "^9.3.10",
    "supercluster": "^8.0.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.33",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.0.6",
    "vuefire": "^3.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/google.maps": "^3.66.4",
    "@types/node": "^22.19.17",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.9.0",
    "globals": "15.15.0",
    "happy-dom": "^20.14.5",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.2.8"
  }
}
