# Google Play lanes. The service account key comes from the login keychain,
# never a file (docs/store-screenshots.md › Keys).

def keychain(service)
  value = `security find-generic-password -s #{service} -w 2>/dev/null`.strip
  UI.user_error!("#{service} isn't in the login keychain: see docs/store-screenshots.md › Keys") if value.empty?
  value
end

default_platform(:android)

platform :android do
  desc "Replace the store listing's images: phone screenshots (made by `npm run store` in web/), icon and feature graphic (copies of resources/). Nothing else: no build, no text. Google reviews the change before it shows."
  lane :screenshots do
    upload_to_play_store(
      json_key_data: keychain("scotdance-play"),
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end

  desc "Build a beta bundle (after the version bump and `npm run build` at the root), signed with the upload key from the keychain (app/build.gradle), and send it to open testing, the beta link's track, with the beta notes (metadata/android/en-CA/changelogs/default.txt). Google reviews it first."
  lane :beta do
    gradle(task: "bundle", build_type: "Release")
    upload_to_play_store(
      json_key_data: keychain("scotdance-play"),
      track: "beta",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      metadata_path: "./fastlane/metadata/android",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
