{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "target": "es2020",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node10",
    "ignoreDeprecations": "5.0"
  },
  "compileOnSave": true,
  "include": ["src"]
}
