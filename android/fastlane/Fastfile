# Google Play lanes. The service account key's path comes from
# SUPPLY_JSON_KEY in fastlane/.env, git-ignored (docs/store-screenshots.md).

default_platform(:android)

platform :android do
  desc "Replace the store listing's images: phone screenshots (made by `npm run store` in web/), icon and feature graphic (copies of resources/). Nothing else: no build, no text. Google reviews the change before it shows."
  lane :screenshots do
    upload_to_play_store(
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end

  desc "Build a beta bundle (after the version bump and `npm run build` at the root), signed with the upload key from the keychain (app/build.gradle), and send it to open testing, the beta link's track, with the beta notes (metadata/android/en-CA/changelogs/default.txt). Google reviews it first."
  lane :beta do
    gradle(task: "bundle", build_type: "Release")
    upload_to_play_store(
      track: "beta",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      metadata_path: "./fastlane/metadata/android",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
