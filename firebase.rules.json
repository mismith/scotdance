{
  "rules": {
    "$environment": {
      ".read": "root.child($environment).child('users:permissions').child(auth.uid).child('admin').val() === true", // is ADMIN
      ".write": "root.child($environment).child('users:permissions').child(auth.uid).child('admin').val() === true", // is ADMIN

      "versions": {
        ".read": true
      },
      "faqs": {
        ".read": true
      },
      "featureFlags": {
        ".read": true
      },
      "competitions": {
        ".read": true,
        "$competitionId": {
          ".write": "root.child($environment).child('users:permissions').child(auth.uid).child('competitions').child($competitionId).val() === true" // has PERMISSION
        },
        ".indexOn": ["date"]
      },
      "judges": {
        ".read": true
      },
      "judges:index": {
        ".read": true
      },
      "pipers": {
        ".read": true
      },
      "pipers:index": {
        ".read": true
      },
      "venues": {
        ".read": true
      },
      "venues:index": {
        ".read": true
      },
      "dancers": {
        ".read": true
      },
      "dancers:index": {
        ".read": true
      },
      "dancers:profiles": {
        ".read": true,
        "$dancerId": {
          ".write": "auth !== null && root.child($environment).child('dancers:guardians').child($dancerId).child(auth.uid).child('status').val() === 'approved'", // is LINKED to this dancer
          ".validate": "newData.hasChildren(['tartanId']) && newData.child('tartanId').isString() && newData.child('tartanId').val().length <= 64",
          "tartanId": { ".validate": true },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "dancers:guardians": {
        "$dancerId": {
          ".read": "auth !== null && root.child($environment).child('dancers:guardians').child($dancerId).child(auth.uid).child('status').val() === 'approved'", // is LINKED to this dancer
          "$userId": {
            ".read": "auth !== null && auth.uid === $userId", // is SELF
            ".write": "auth !== null && ((auth.uid === $userId && ((!data.exists() && newData.child('status').val() === 'pending') || !newData.exists())) || root.child($environment).child('dancers:guardians').child($dancerId).child(auth.uid).child('status').val() === 'approved')", // is SELF asking or withdrawing || is LINKED to this dancer
            ".validate": "newData.hasChildren(['status', 'relationship', 'createdAt'])",
            "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'denied'" },
            "relationship": { ".validate": "newData.val() === 'parent' || newData.val() === 'self' || newData.val() === 'teacher'" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "dancerName": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 280" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      },
      "tartans": {
        ".read": true
      },
      "competitions:data": {
        "$competitionId": {
          "staff": {
            ".read": true
          },
          "invites": {
            "$inviteId": {
              ".read": "auth !== null", // is AUTHED
              ".write": "auth !== null" // is AUTHED
            }
          },
          ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true || root.child($environment).child('users:permissions').child(auth.uid).child('competitions').child($competitionId).val() === true", // is PUBLISHED || has PERMISSION
          ".write": "root.child($environment).child('users:permissions').child(auth.uid).child('competitions').child($competitionId).val() === true" // has PERMISSION
        }
      },
      "competitions:submissions": {
        "$competitionId": {
          ".write": "auth !== null && !data.exists() && !newData.child('approved').exists()" // is AUTHED and CREATING and NOT approving
        }
      },
      "competitions:permissions": {
        "$competitionId": {
          ".read": "root.child($environment).child('users:permissions').child(auth.uid).child('competitions').child($competitionId).val() === true" // has PERMISSION to same COMPETITION
        }
      },
      "users": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId" // is SELF
        }
      },
      "users:favorites": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId" // is SELF
        }
      },
      "users:dancers": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId", // is SELF
          "$dancerId": { ".validate": "newData.isString() && newData.val().length <= 100" }
        }
      },
      "users:tartans": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          "$tartanId": {
            ".write": "auth !== null && auth.uid === $userId && (!newData.exists() || (!data.child('declined').exists() && !newData.child('declined').exists()))", // is SELF, deleting or not touching a decline
            ".validate": "newData.hasChildren(['name', 'threadcount', 'palette', 'createdAt']) && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('threadcount').isString() && newData.child('threadcount').val().length <= 600"
          }
        }
      },
      "users:permissions": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId && !newData.exists()" // is REMOVING OWN permissions
        }
      }
    }
  }
}
