{
	"appId": "info.mismith.scotdance",
	"appName": "ScotDance",
	"npmClient": "npm",
	"webDir": "web/dist",
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"showSpinner": false,
			"launchFadeOutDuration": 0
		},
		"FirebaseMessaging": {
			"presentationOptions": []
		}
	},
	"experimental": {
		"ios": {
			"spm": {
				"swiftToolsVersion": "6.1",
				"packageTraits": {
					"@capacitor-firebase/analytics": [
						"AnalyticsWithoutAdIdSupport"
					]
				}
			}
		}
	}
}
