{
  "rules": {
    "$environment": {
      ".read": "root.child($environment).child('users:permissions').child(auth.uid).child('admin').val() === true", // is ADMIN
      ".write": "root.child($environment).child('users:permissions').child(auth.uid).child('admin').val() === true", // is ADMIN

      "versions": {
        ".read": true
      },
      "faqs": {
        ".read": true
      },
      "featureFlags": {
        ".read": true
      },
      "competitions": {
        ".read": true,
        "$competitionId": {
          ".write": "root.child($environment).child('users:permissions').child(auth.uid).child('competitions').child($competitionId).val() === true", // has PERMISSION
          // A part it takes from its linked primary (ADR 0007) changes there, not here: a write that changes it is refused (functions copy it in)
          "description": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('about').val() !== true" }, // UNCHANGED or not SYNCED (about)
          "image": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('about').val() !== true" }, // UNCHANGED or not SYNCED (about)
          "venue": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('venue').val() !== true" }, // UNCHANGED or not SYNCED (venue)
          "address": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('venue').val() !== true" }, // UNCHANGED or not SYNCED (venue)
          "location": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('venue').val() !== true" }, // UNCHANGED or not SYNCED (venue)
          "lat": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('venue').val() !== true" }, // UNCHANGED or not SYNCED (venue)
          "lng": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('venue').val() !== true" }, // UNCHANGED or not SYNCED (venue)
          "country": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('venue').val() !== true" }, // UNCHANGED or not SYNCED (venue)
          "region": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('venue').val() !== true" }, // UNCHANGED or not SYNCED (venue)
          "locality": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('venue').val() !== true" }, // UNCHANGED or not SYNCED (venue)
          "space": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('venue').val() !== true" }, // UNCHANGED or not SYNCED (venue)
          "registrationURL": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('registration').val() !== true" }, // UNCHANGED or not SYNCED (registration)
          "registrationStart": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('registration').val() !== true" }, // UNCHANGED or not SYNCED (registration)
          "registrationEnd": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('registration').val() !== true" }, // UNCHANGED or not SYNCED (registration)
          "listed": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('visibility').val() !== true" }, // UNCHANGED or not SYNCED (visibility)
          "published": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('visibility').val() !== true" }, // UNCHANGED or not SYNCED (visibility)
          "links": {
            ".validate": "newData.hasChildren() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('links').val() !== true", // a LIST, or not SYNCED (links)
            "$linkId": {
              ".validate": "newData.hasChildren() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('links').val() !== true",
              "$field": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('links').val() !== true" } // UNCHANGED or not SYNCED (links)
            }
          },
          "organisations": {
            ".validate": "newData.hasChildren() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('organisations').val() !== true", // a LIST, or not SYNCED (organisations)
            "$organisationId": {
              // An organisation's admins add its competitions and take them off.
              // A competition's admins can take any off (the write above), but
              // add only an organisation they're an admin of.
              ".write": "root.child($environment).child('users:permissions').child(auth.uid).child('organisations').child($organisationId).val() === true", // has PERMISSION to the ORGANISATION
              ".validate": "newData.val() === true && root.child($environment).child('organisations').child($organisationId).exists() && (root.child($environment).child('users:permissions').child(auth.uid).child('organisations').child($organisationId).val() === true || root.child($environment).child('users:permissions').child(auth.uid).child('admin').val() === true) && (data.val() === true || root.child($environment).child('competitionLinks:sync').child($competitionId).child('organisations').val() !== true)" // an existing ORGANISATION its ADMIN (or a system ADMIN) adds, unless it takes its organisations from its linked primary
            }
          }
        },
        ".indexOn": ["date"]
      },
      "organisations": {
        ".read": true,
        "$organisationId": {
          // Its admins edit its page. Making or deleting one is for functions
          // (createOrganisation, an approved submission) and system admins.
          ".write": "data.exists() && newData.exists() && root.child($environment).child('users:permissions').child(auth.uid).child('organisations').child($organisationId).val() === true", // has PERMISSION and EDITING
          ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0"
        }
      },
      "organisations:data": {
        "$organisationId": {
          // Its admins' private bits: invites (emails, open invite ids).
          "invites": {
            "$inviteId": {
              ".read": "auth !== null", // is AUTHED
              "accepted": {
                ".write": "auth !== null && data.parent().exists() && !data.exists() && newData.exists() && !data.parent().child('cancelled').exists()" // is AUTHED and ACCEPTING an open invite
              }
            }
          },
          ".read": "root.child($environment).child('users:permissions').child(auth.uid).child('organisations').child($organisationId).val() === true", // has PERMISSION
          ".write": "root.child($environment).child('users:permissions').child(auth.uid).child('organisations').child($organisationId).val() === true" // has PERMISSION
        }
      },
      "organisations:permissions": {
        "$organisationId": {
          ".read": "root.child($environment).child('users:permissions').child(auth.uid).child('organisations').child($organisationId).val() === true" // has PERMISSION to same ORGANISATION
        }
      },
      // Linked competitions (ADR 0007): which go together, and what each takes from its primary. Public; only functions write them (linkCompetitions).
      "competitionLinks": { ".read": true },
      "competitionLinks:of": { ".read": true },
      "competitionLinks:sync": { ".read": true },
      // Known competitions (ADR 0009): the governing bodies' public lists, suggested on Add a competition. Only functions write them (refreshKnownCompetitions); how each source's last run went (knownCompetitions:runs) is for system admins.
      "knownCompetitions": {
        ".read": "auth !== null", // is AUTHED
        ".indexOn": ["date"]
      },
      "competitions:changed": {
        // When each part of a competition last changed (stamped by functions), so the app re-uses what it has
        "$competitionId": { ".read": true }
      },
      "judges": {
        "$id": { ".read": true } // one at a time: the whole tree is too big to hand out
      },
      "judges:index": {
        ".read": true
      },
      "pipers": {
        "$id": { ".read": true } // one at a time: the whole tree is too big to hand out
      },
      "pipers:index": {
        ".read": true
      },
      "venues": {
        "$id": { ".read": true } // one at a time: the whole tree is too big to hand out
      },
      "venues:index": {
        ".read": true
      },
      "dancers": {
        "$id": { ".read": true } // one at a time: the whole tree is too big to hand out
      },
      "dancers:index": {
        "$key": { ".read": true } // one at a time, like the profiles: the app only looks up names
      },
      "competitions:data": {
        "$competitionId": {
          // Organisers read and write everything here, invites included. The
          // public reads a published competition section by section (both apps
          // do), so invites (emails, open invite ids) stay private.
          "dancers": {
            ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true", // is PUBLISHED
            ".indexOn": ["groupId", "dancerId"] // result alerts look up an age group's entries; Home, a followed dancer's
          },
          "groups": { ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true" }, // is PUBLISHED
          "categories": { ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true" }, // is PUBLISHED
          "dances": { ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true" }, // is PUBLISHED
          "platforms": { ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true" }, // is PUBLISHED
          "schedule": { ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true" }, // is PUBLISHED
          "draws": { ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true" }, // is PUBLISHED
          "results": { ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true" }, // is PUBLISHED
          "points": { ".read": "root.child($environment).child('competitions').child($competitionId).child('published').val() === true" }, // is PUBLISHED
          "staff": {
            // Judges and sponsors show once a competition is listed; a private one keeps them private.
            ".read": "root.child($environment).child('competitions').child($competitionId).child('listed').val() === true || root.child($environment).child('competitions').child($competitionId).child('published').val() === true", // is LISTED || PUBLISHED
            "$staffId": {
              ".validate": "newData.hasChildren() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('staff').val() !== true", // a RECORD, or not SYNCED
              "$field": { ".validate": "newData.val() === data.val() || root.child($environment).child('competitionLinks:sync').child($competitionId).child('staff').val() !== true" } // UNCHANGED or not SYNCED from its linked primary (ADR 0007)
            }
          },
          "invites": {
            "$inviteId": {
              ".read": "auth !== null", // is AUTHED
              // Organisers manage invites (competitions:data write below). Anyone else may
              // only accept one: they can't make their own, take an accepted one over, or
              // accept a cancelled one.
              "accepted": {
                ".write": "auth !== null && data.parent().exists() && !data.exists() && newData.exists() && !data.parent().child('cancelled').exists()" // is AUTHED and ACCEPTING an open invite
              }
            }
          },
          ".read": "root.child($environment).child('users:permissions').child(auth.uid).child('competitions').child($competitionId).val() === true", // has PERMISSION
          ".write": "root.child($environment).child('users:permissions').child(auth.uid).child('competitions').child($competitionId).val() === true" // has PERMISSION
        }
      },
      "competitions:submissions": {
        ".indexOn": ["submittedBy", "receivedAt", "competition/date", "linkedTo"], // the flood check; what else is submitted for the same day; the ones to link with it once approved
        "$competitionId": {
          ".write": "auth !== null && !data.exists() && !newData.child('approved').exists() && !newData.child('rejected').exists() && !newData.child('rejection').exists() && !newData.child('replied').exists() && !newData.child('replyFailed').exists() && !newData.child('autoApproved').exists() && !newData.child('review').exists()", // is AUTHED and CREATING and NOT approving or rejecting (or saying a reply went out, or that it needs no review)
          ".validate": "data.exists() || (newData.child('competition/name').isString() && !newData.child('competition/name').val().matches(/^ *$/) && newData.child('competition/date').isString() && newData.child('competition/date').val().matches(/^\\d{4}-\\d{2}-\\d{2}$/) && newData.child('competition/location').isString() && !newData.child('competition/location').val().matches(/^ *$/))" // a NEW one has a NAME, a DATE (YYYY-MM-DD) and a TOWN or CITY; edits to one already sent (System admin) aren't held to it
        }
      },
      "competitions:permissions": {
        "$competitionId": {
          ".read": "root.child($environment).child('users:permissions').child(auth.uid).child('competitions').child($competitionId).val() === true" // has PERMISSION to same COMPETITION
        }
      },
      "users": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId" // is SELF
        }
      },
      "users:favorites": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId" // is SELF
        }
      },
      "users:alertsOff": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId", // is SELF
          // A favourite dancer with their alerts turned off (ADR 0008).
          "dancers": {
            "$dancerId": { ".validate": "newData.val() === true" }
          },
          "$other": { ".validate": false }
        }
      },
      "users:tokens": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId" // is SELF: device push tokens
        }
      },
      "users:dancerColors": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId", // is SELF
          // A colour ('dancer-3' or '#rrggbb'), or a tartan woven in one: the
          // builder's sett (up to 14 stripes in 4 widths) and the colour of
          // each letter in it but K and W (see web/src/lib/tartan.ts).
          "$dancerId": {
            ".validate": "(newData.isString() && newData.val().length <= 16) || newData.hasChildren(['color', 'sett'])",
            "color": { ".validate": "newData.isString() && newData.val().matches(/^(dancer-[1-9]|#[0-9a-fA-F]{6})$/)" },
            "sett": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z](2|6|16|40)( [A-Z](2|6|16|40)){0,13}$/)" },
            "colors": {
              "$code": { ".validate": "$code.matches(/^[A-JL-VX-Z]$/) && newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" }
            },
            "$other": { ".validate": false }
          }
        }
      },
      "users:permissions": {
        "$userId": {
          ".read": "auth !== null && auth.uid === $userId", // is SELF
          ".write": "auth !== null && auth.uid === $userId && !newData.exists()" // is REMOVING OWN permissions
        }
      }
    }
  }
}
