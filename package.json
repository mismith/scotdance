{
  "name": "scotdance",
  "version": "4.0.6",
  "type": "module",
  "description": "Highland dancing event tracker",
  "author": "Murray Rowan <murray@mismith.info>",
  "scripts": {
    "build": "npm --prefix web run build && cap sync",
    "store:upload:ios": "npm --prefix web run store:upload:ios",
    "store:upload:android": "npm --prefix web run store:upload:android",
    "set-version": "node ./set-version.js",
    "postset-version": "npx cap copy",
    "known:sdc": "npm --prefix functions run build && node functions/scripts/refresh-sdc.mjs",
    "release": "git commit -a -m $npm_package_version && git tag \"v${npm_package_version}\"",
    "deploy": "firebase deploy --only hosting:production,functions,database,storage && git push origin HEAD:main --tags"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/text-zoom": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "firebase-tools": "^15.34.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/mismith/scotdance.git"
  }
}
