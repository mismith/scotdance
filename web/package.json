{
  "name": "scotdance-web",
  "private": true,
  "version": "4.0.0-alpha.0",
  "type": "module",
  "description": "Highland dancing event tracker",
  "author": "Murray Rowan <murray@mismith.info>",
  "scripts": {
    "dev": "vite",
    "emulate": "cd .. && firebase emulators:start --import=.firebase/emulator-data --export-on-exit",
    "emulate:typesense": "cd .. && ./typesense-server --log-dir .typesense/logs --data-dir .typesense/emulator-data --listen-port=8108 --api-key=xyz --enable-cors",
    "local": "concurrently -k -n fb,ts,vite -c blue,yellow,green \"npm:emulate\" \"npm:emulate:typesense\" \"vite --mode emulator\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "report": "REPORT=true vite build"
  },
  "dependencies": {
    "@lucide/vue": "^1.14.0",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compare-versions": "^6.1.1",
    "firebase": "^12.12.1",
    "fuse.js": "^7.3.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "vuefire": "^3.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vue-tsc": "^3.2.8"
  }
}
