# App Store lanes. Keys come from fastlane/.env (git-ignored), never this repo
# (docs/store-screenshots.md):
#   APP_STORE_CONNECT_API_KEY_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID,
#   APP_STORE_CONNECT_API_KEY_KEY_FILEPATH (the .p8)

default_platform(:ios)

platform :ios do
  desc "Upload the store screenshots (made by `npm run store` in web/) to the version being prepared in App Store Connect. Nothing else: no build, no text, no submission."
  lane :screenshots do
    app_store_connect_api_key
    deliver(
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  desc "Build a beta (after the version bump and `npm run build` at the root), upload it to TestFlight and send it to Early Access, the public link's group, with the beta notes as What to Test. A new version waits for Beta App Review."
  lane :beta do
    # Before the API key: the export signs with Xcode's account, since the
    # key (App Manager) can't use Apple's cloud signing.
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store-connect",
      export_xcargs: "-allowProvisioningUpdates",
      output_directory: "./build",
    )
    app_store_connect_api_key
    upload_to_testflight(
      groups: ["Early Access"],
      distribute_external: true,
      notify_external_testers: true,
      changelog: File.read("../../../android/fastlane/metadata/android/en-CA/changelogs/default.txt"),
    )
  end
end
