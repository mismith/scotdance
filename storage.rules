rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone signed in may upload, so files can only be fetched by name (no
    // listing) and only added (uploads get unique names), never replaced or deleted.
    match /{ENV} {
      match /competitions {
      	// DEPRECATED: /images
        match /images/{fileName} {
          allow get;
          allow create: if request.auth != null
                       && request.resource.size < 244 * 1024
                       && request.resource.contentType.matches('image/.*');
        }
      	match /info/{fileName} {
          allow get;
          allow create: if request.auth != null
                       && request.resource.size < 244 * 1024
                       && request.resource.contentType.matches('image/.*');
        }
      	match /staff/{fileName} {
          allow get;
          allow create: if request.auth != null
                       && request.resource.size < 244 * 1024
                       && request.resource.contentType.matches('image/.*');
        }
      	match /links/{fileName} {
          allow get;
          allow create: if request.auth != null
                       && request.resource.size < 244 * 4 * 1024
                       && request.resource.contentType.matches('application/pdf|image/.*');
        }
      }
    }
  }
}
