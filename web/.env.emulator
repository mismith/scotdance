VITE_FIREBASE_DATA_NAMESPACE=development
# Don't set VITE_GOOGLE_MAPS_API_KEY here — it comes from .env.local (gitignored).
# Vite gives mode files precedence over .env.local, so a value here would override yours.

# Explicit fictional E2E tool origins; never used by connected/live-auth development.
VITE_LOCAL_CHALLENGE_ORIGIN=http://localhost:5299
VITE_LOCAL_CONNECT_ORIGIN=http://localhost:5298
