# Google Play lanes. The service account key's path comes from
# SUPPLY_JSON_KEY in fastlane/.env, git-ignored (docs/store-screenshots.md).

default_platform(:android)

platform :android do
  desc "Replace the store listing's images: phone screenshots (made by `npm run store` in web/), icon and feature graphic (copies of resources/). Nothing else: no build, no text. Google reviews the change before it shows."
  lane :screenshots do
    upload_to_play_store(
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
    )
  end

  desc "Send the bundle Android Studio signed (Build › Generate Signed App Bundle, release) to open testing, the beta link's track, with the beta notes (metadata/android/en-CA/changelogs/default.txt). Google reviews it first."
  lane :beta do
    upload_to_play_store(
      track: "beta",
      aab: "./app/release/app-release.aab",
      metadata_path: "./fastlane/metadata/android",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
