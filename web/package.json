{
  "name": "scotdance-web",
  "private": true,
  "version": "4.0.0-alpha.0",
  "type": "module",
  "description": "Highland dancing event tracker",
  "author": "Murray Rowan <murray@mismith.info>",
  "scripts": {
    "dev:functions": "npm --prefix ../functions run dev",
    "dev:web": "vite",
    "dev": "concurrently -k -n fn,web -c magenta,green \"npm:dev:functions\" \"npm:dev:web\"",
    "emulate:firebase": "cd .. && firebase emulators:start --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data",
    "emulate:typesense": "cd .. && ./typesense-server --log-dir .typesense/logs --data-dir .typesense/emulator-data --listen-port=8108 --api-key=xyz --enable-cors",
    "local": "concurrently -k -n fn,fb,ts,web -c magenta,blue,yellow,green  \"npm:dev:functions\" \"npm:emulate:firebase\" \"npm:emulate:typesense\" \"vite --mode emulator\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,json,css}\"",
    "report": "REPORT=true vite build"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@lucide/vue": "^1.14.0",
    "@unhead/vue": "^3.1.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/router": "^14.3.0",
    "compare-versions": "^6.1.1",
    "firebase": "^12.12.1",
    "fuse.js": "^7.3.0",
    "maplibre-gl": "^5.24.0",
    "pinia": "^3.0.4",
    "supercluster": "^8.0.1",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "vuefire": "^3.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.19.17",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.9.0",
    "globals": "15.15.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "^8.0.10",
    "vue-tsc": "^3.2.8"
  }
}
