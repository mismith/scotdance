# App Store lanes. The API key comes from the login keychain, never a file
# (docs/store-screenshots.md › Keys).

def keychain(service)
  value = `security find-generic-password -s #{service} -w 2>/dev/null`.strip
  UI.user_error!("#{service} isn't in the login keychain: see docs/store-screenshots.md › Keys") if value.empty?
  value
end

def asc_api_key
  key = JSON.parse(keychain("scotdance-asc"))
  app_store_connect_api_key(key_id: key["key_id"], issuer_id: key["issuer_id"], key_content: key["key"])
end

# Signing for the store, without Xcode's account (a command-line export can't
# read Xcode's sign-in) or Apple's cloud signing (the API key, App Manager,
# can't use it): the distribution certificate's .p12 sits in the login
# keychain (base64), and goes into a throwaway keychain with a random password
# for the build, so nothing asks to be let in. The first run makes the
# certificate and keeps it. Yields the App Store profile's name.
DISTRIBUTION = "scotdance-ios-distribution"
SIGNING_KEYCHAIN = "scotdance-signing"

def with_store_signing
  require "base64"
  require "securerandom"
  require "tmpdir"
  dir = Dir.mktmpdir
  password = SecureRandom.hex(24)
  path = File.expand_path("~/Library/Keychains/#{SIGNING_KEYCHAIN}-db")
  delete_keychain(name: SIGNING_KEYCHAIN) if File.exist?(path)
  create_keychain(name: SIGNING_KEYCHAIN, password: password, unlock: true, timeout: 0, lock_when_sleeps: false, default_keychain: false, add_to_search_list: true)
  stored = `security find-generic-password -s #{DISTRIBUTION} -w 2>/dev/null`.strip
  if stored.empty?
    get_certificates(output_path: dir, keychain_path: path, keychain_password: password)
    p12 = Dir[File.join(dir, "*.p12")].first or UI.user_error!("get_certificates left no .p12")
    sh("security", "add-generic-password", "-U", "-s", DISTRIBUTION, "-a", "scotdance", "-w", Base64.strict_encode64(File.binread(p12)), log: false)
  else
    p12 = File.join(dir, "distribution.p12")
    File.binwrite(p12, Base64.decode64(stored))
    import_certificate(certificate_path: p12, certificate_password: "", keychain_path: path, keychain_password: password, log_output: false)
  end
  get_provisioning_profile(output_path: dir, skip_install: false)
  yield lane_context[SharedValues::SIGH_NAME]
ensure
  delete_keychain(name: SIGNING_KEYCHAIN) if File.exist?(path.to_s)
  FileUtils.rm_rf(dir) if dir
end

default_platform(:ios)

platform :ios do
  desc "Upload the store screenshots (made by `npm run store` in web/) to the version being prepared in App Store Connect. Nothing else: no build, no text, no submission."
  lane :screenshots do
    asc_api_key
    deliver(
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  desc "Build a beta (after the version bump and `npm run build` at the root), upload it to TestFlight and send it to Early Access, the public link's group, with the beta notes as What to Test. A new version waits for Beta App Review."
  lane :beta do
    asc_api_key
    with_store_signing do |profile|
      build_app(
        project: "App.xcodeproj",
        scheme: "App",
        export_method: "app-store",
        export_options: {
          signingStyle: "manual",
          signingCertificate: "Apple Distribution",
          provisioningProfiles: { "info.mismith.scotdance" => profile },
        },
        output_directory: "./build",
      )
    end
    upload_to_testflight(
      groups: ["Early Access"],
      distribute_external: true,
      notify_external_testers: true,
      changelog: File.read("../../../android/fastlane/metadata/android/en-CA/changelogs/default.txt"),
    )
  end
end
